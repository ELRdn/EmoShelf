{
  "name": "emoshelf",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node tools/check-bundle-size.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run && node --test tools/*.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "tsc --noEmit && biome check . && vitest run && node --test tools/*.node-test.mjs",
    "test:e2e": "wdio run e2e/wdio.conf.mjs",
    "release:audit": "node tools/release-audit.mjs",
    "release:latest-json": "node tools/release-manifest.mjs latest-json",
    "release:checksums": "node tools/release-manifest.mjs checksums",
    "renderer:prepare": "node tools/prepare-renderer-pack.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@twemoji/svg": "^15.0.0",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.31.0",
    "@wdio/local-runner": "^9.31.0",
    "@wdio/mocha-framework": "^9.31.0",
    "@wdio/spec-reporter": "^9.31.0",
    "axe-core": "^4.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^5.0.0"
  }
}
