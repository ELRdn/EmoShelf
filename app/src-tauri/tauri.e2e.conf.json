{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.emoshelf.e2e",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EmoShelf",
        "width": 880,
        "height": 660,
        "minWidth": 480,
        "minHeight": 320,
        "visible": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "description": "Test-only capability for the embedded WebDriver server",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
