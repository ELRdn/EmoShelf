{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmoShelf",
  "version": "0.5.0",
  "identifier": "com.emoshelf.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EmoShelf",
        "width": 880,
        "height": 660,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://github.com/ELRdn/EmoShelf/releases/latest/download/latest.json",
        "img-src": "'self' data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ELRdn/EmoShelf/releases/latest/download/latest.json"
      ],
      "pubkey": "EMOSHELF_UPDATER_PUBLIC_KEY_REQUIRED_AT_RELEASE",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
